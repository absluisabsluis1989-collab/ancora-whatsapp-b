# Copie estes nomes para o ambiente do servidor. Não grave segredo neste arquivo.
# WhatsApp, Z-API, modelo pago e DIANA ficam desligados.

APP_WORKSPACE=B
APP_STAGE=BUILD_ONLY
WHATSAPP_SELF_PHONE=63992731001
ZAPI_SEND_ENABLED=0
DIANA_INTEGRATION_ENABLED=0
MODEL_STATUS=NOT_CONFIGURED

# Postgres do próprio aplicativo. Sem esta variável o processo usa PGLite em memória
# e os dados somem quando o processo para. Não é o banco da DIANA.
# DATABASE_URL=postgres://USUARIO:SENHA@HOST/neondb?sslmode=require

# Segredo de sessão do Better Auth. Gere um valor novo na publicação.
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=https://ancora-whatsapp-b.vercel.app

# Processo npm run fila. Sem um destes segredos o tick recusa.
# QUEUE_TICK_SECRET=
# CRON_SECRET=
# APP_URL=http://127.0.0.1:8080
# QUEUE_TICK_INTERVAL_MS=15000

# Não preencher enquanto a revisão não ligar cada serviço.
# MODEL_API_KEY=
# MODEL_NAME=claude-sonnet-4-6
# ZAPI_INSTANCE_ID=
# ZAPI_TOKEN=
# ZAPI_CLIENT_TOKEN=
# ZAPI_WEBHOOK_SECRET=
